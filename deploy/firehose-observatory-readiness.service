[Unit]
Description=Verify published Bluesky accessibility observatory artifacts
After=network-online.target firehose-observatory-publish.service
Wants=network-online.target

[Service]
Type=oneshot
User=coolhand
Group=coolhand
WorkingDirectory=/home/coolhand/servers/firehose
EnvironmentFile=/etc/dreamer/firehose-observatory.env
Environment=HOME=/home/coolhand
ExecStart=/home/coolhand/servers/firehose/observatory/.venv/bin/python /home/coolhand/servers/firehose/observatory/readiness.py --require-complete
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/coolhand/firehose-data/observatory
UMask=0077
MemoryMax=1536M
TasksMax=128
