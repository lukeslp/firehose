[Unit]
Description=Ingest sealed Bluesky accessibility observatory segments
After=firehose.service

[Service]
Type=oneshot
User=coolhand
Group=coolhand
WorkingDirectory=/home/coolhand/servers/firehose
EnvironmentFile=/etc/dreamer/firehose-observatory.env
Environment=HOME=/home/coolhand
ExecStart=/home/coolhand/servers/firehose/observatory/.venv/bin/python /home/coolhand/servers/firehose/observatory/publisher.py ingest
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=full
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/coolhand/firehose-data/observatory
UMask=0077
MemoryMax=1024M
TasksMax=128
