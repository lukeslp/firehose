# Install as mode 0600 /etc/dreamer/firehose-observatory.env.
# Hugging Face authentication uses the existing drummer lukeslp login; do not
# put a token in this file or in a systemd unit.
RAW_ARCHIVE_DIR=/home/coolhand/firehose-data/raw
OBSERVATORY_STATE_DIR=/home/coolhand/firehose-data/observatory
OBSERVATORY_HF_REPO=lukeslp/bluesky-alt-text-observatory
OBSERVATORY_SOURCE_DIR=/home/coolhand/servers/firehose
OBSERVATORY_PUBLIC_URLS=https://dr.eamer.dev/bluesky/firehose/accessibility/,https://dr.eamer.dev/downloads/bluesky-alt-text/
