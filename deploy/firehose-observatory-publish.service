[Unit]
Description=Publish Bluesky accessibility observatory Parquet shards
After=network-online.target firehose-observatory-ingest.service
Wants=network-online.target

[Service]
Type=oneshot
User=coolhand
Group=coolhand
WorkingDirectory=/home/coolhand/servers/firehose
EnvironmentFile=/etc/dreamer/firehose-observatory.env
Environment=HOME=/home/coolhand
Environment=HF_HOME=/home/coolhand/firehose-data/observatory/huggingface
Environment=HF_XET_CACHE=/home/coolhand/firehose-data/observatory/huggingface/xet
ExecStart=/home/coolhand/servers/firehose/observatory/.venv/bin/python /home/coolhand/servers/firehose/observatory/publisher.py publish
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/home/coolhand/firehose-data/observatory
UMask=0077
MemoryMax=1536M
TasksMax=128
